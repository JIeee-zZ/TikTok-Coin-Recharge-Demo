{
  "expo": {
    "name": "Coin Recharge",
    "slug": "coinrecharge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinrecharge",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f7f6f4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coinrecharge.app"
    },
    "android": {
      "package": "com.coinrecharge.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}